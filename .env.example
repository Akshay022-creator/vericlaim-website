# 7-Provider Real-Time Global News API Configuration (Example Template)

# 1. NewsAPI (Global News Wire)
NEWS_API_KEY=your_newsapi_key_here

# 2. NewsData.io (International & Regional News)
NEWSDATA_API_KEY=your_newsdata_key_here

# 3. GNews.io (Breaking News Search)
GNEWS_API_KEY=your_gnews_key_here

# 4. WorldNewsAPI.com (Worldwide Multilingual News Search)
WORLDNEWS_API_KEY=your_worldnews_key_here

# 5. The Guardian Open Platform (Global Quality Journalism)
GUARDIAN_API_KEY=your_guardian_key_here

# 6. Currents API (Fast Real-Time Global News Wire)
CURRENTS_API_KEY=your_currents_key_here

# 7. Mediastack API (Live Worldwide News Data Feed)
MEDIASTACK_API_KEY=your_mediastack_key_here
